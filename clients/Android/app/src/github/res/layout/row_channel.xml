<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_setrow"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/channel_update"
            android:textAppearance="@style/TextAppearance.Loft.RowK"
            android:textColor="@color/snow" />

        <TextView
            android:id="@+id/channel_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/channel_update_d"
            android:textAppearance="@style/TextAppearance.Loft.RowS"
            android:textColor="@color/mute" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_channel"
        style="@style/Widget.Loft.GhostSm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/channel_check" />
</LinearLayout>
