<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Loft" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:textColor">@color/snow</item>
        <item name="android:textColorPrimary">@color/snow</item>
        <item name="android:textColorSecondary">@color/mute</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorPrimary">@color/lamp</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/copper</item>
        <item name="colorSurface">@color/ink2</item>
        <item name="colorOnSurface">@color/snow</item>
        <item name="colorError">@color/err</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Loft.Sheet</item>
        <item name="bottomNavigationStyle">@style/Widget.Loft.Nav</item>
    </style>

    <style name="Theme.Loft.Sheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Loft.Sheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/lamp</item>
        <item name="colorOnSurface">@color/snow</item>
        <item name="android:colorBackground">@color/ink2</item>
    </style>

    <style name="Widget.Loft.Sheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="backgroundTint">@color/ink2</item>
        <item name="shapeAppearance">@style/Shape.Loft.Sheet</item>
    </style>

    <style name="Shape.Loft.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Shape.Loft.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Loft.Nav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/ink</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_icon</item>
        <item name="itemTextColor">@color/nav_text</item>
        <item name="itemRippleColor">@color/lamp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Loft.NavIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Loft.NavIndicator" parent="">
        <item name="android:color">@color/lamp22</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/Shape.Loft.NavPill</item>
    </style>

    <style name="Shape.Loft.NavPill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Loft.Go" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/lamp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Loft.Ghost" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/slate</item>
        <item name="android:textColor">@color/snow</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Loft.Danger" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/danger_bg</item>
        <item name="android:textColor">@color/danger_fg</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Loft.Mini" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/slate</item>
        <item name="android:textColor">@color/snow</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Loft.Chip" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
