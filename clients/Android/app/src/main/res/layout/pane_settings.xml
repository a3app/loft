<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/settings"
                android:textAppearance="@style/TextAppearance.Loft.Title"
                android:textColor="@color/snow" />

            <Button
                android:id="@+id/btn_lists"
                style="@style/Widget.Loft.HeadBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lists" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:text="@string/general"
            android:textAppearance="@style/TextAppearance.Loft.Grp"
            android:textColor="@color/mute" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/simple"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/simple_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_simple"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/rate_unit"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/rate_unit_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <Spinner
                android:id="@+id/sp_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_select"
                android:overlapAnchor="false"
                android:popupBackground="@color/ink2"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/spark_k"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/spark_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <Spinner
                android:id="@+id/sp_spark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_select"
                android:overlapAnchor="false"
                android:popupBackground="@color/ink2"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/language"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/lang_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <Spinner
                android:id="@+id/sp_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_select"
                android:overlapAnchor="false"
                android:popupBackground="@color/ink2"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/extended_log"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/diag_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_log"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:includeFontPadding="false"
            android:text="@string/route_group"
            android:textAppearance="@style/TextAppearance.Loft.Grp"
            android:textColor="@color/mute" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/default_route"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/default_route_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_default"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/hold_sys"
                android:textAppearance="@style/TextAppearance.Loft.RowK"
                android:textColor="@color/snow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/hold_and"
                android:textAppearance="@style/TextAppearance.Loft.RowS"
                android:textColor="@color/mute" />

            <Button
                android:id="@+id/btn_vpn"
                style="@style/Widget.Loft.GhostSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/open_sys" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/split"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/split_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />

                <Button
                    android:id="@+id/btn_routes"
                    style="@style/Widget.Loft.GhostSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lists" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_split"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:includeFontPadding="false"
            android:text="@string/conn_group"
            android:textAppearance="@style/TextAppearance.Loft.Grp"
            android:textColor="@color/mute" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/auto"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/auto_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_auto"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/reconnect"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/reconnect_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_re"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setrow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ext_ip"
                    android:textAppearance="@style/TextAppearance.Loft.RowK"
                    android:textColor="@color/snow" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/ext_ip_d"
                    android:textAppearance="@style/TextAppearance.Loft.RowS"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <app.loft.android.ToggleView
                android:id="@+id/sw_ext"
                style="@style/Widget.Loft.Toggle"
                android:layout_width="42dp"
                android:layout_height="26dp" />
        </LinearLayout>

        <include layout="@layout/row_channel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_defaults"
                style="@style/Widget.Loft.LinkBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/defaults" />

            <Button
                android:id="@+id/btn_log"
                style="@style/Widget.Loft.LinkBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/log" />

            <Button
                android:id="@+id/btn_about"
                style="@style/Widget.Loft.LinkBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/about" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
