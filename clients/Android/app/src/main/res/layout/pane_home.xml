<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/lamp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_lamp_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Loft.Hero"
            android:textColor="@color/snow" />

        <LinearLayout
            android:id="@+id/pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/pill_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/pill_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/pill_off"
                android:textAppearance="@style/TextAppearance.Loft.Pill"
                android:textColor="@color/mute" />
        </LinearLayout>

        <Button
            android:id="@+id/go"
            style="@style/Widget.Loft.Go"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/connect" />

        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/card_k1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proto_k"
                    android:textAppearance="@style/TextAppearance.Loft.PlateK"
                    android:textColor="@color/mute" />

                <TextView
                    android:id="@+id/card_v1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Loft.PlateV"
                    android:textColor="@color/snow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/card_k2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/front_k"
                    android:textAppearance="@style/TextAppearance.Loft.PlateK"
                    android:textColor="@color/mute" />

                <TextView
                    android:id="@+id/card_v2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Loft.PlateV"
                    android:textColor="@color/snow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_plate"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/card_k3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_k"
                    android:textAppearance="@style/TextAppearance.Loft.PlateK"
                    android:textColor="@color/mute" />

                <TextView
                    android:id="@+id/card_v3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Loft.PlateV"
                    android:textColor="@color/snow" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/spark_row"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <app.loft.android.SparkView
                android:id="@+id/spark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- 17/6/17 = SparkView bar rows; each rate is vertically centered in its band. -->
            <LinearLayout
                android:id="@+id/spark_r"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:gravity="end"
                android:minWidth="72dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/rate_dn"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:gravity="end|center_vertical"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Loft.Rate"
                    android:textColor="@color/lamp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp" />

                <TextView
                    android:id="@+id/rate_up"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:gravity="end|center_vertical"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Loft.Rate"
                    android:textColor="@color/stone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/iprows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ext_ip"
                    android:textAppearance="@style/TextAppearance.Loft.IprowK"
                    android:textColor="@color/mute" />

                <TextView
                    android:id="@+id/row_ext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Loft.IprowV"
                    android:textColor="@color/snow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/overlay_ip"
                    android:textAppearance="@style/TextAppearance.Loft.IprowK"
                    android:textColor="@color/mute" />

                <TextView
                    android:id="@+id/row_overlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Loft.IprowV"
                    android:textColor="@color/snow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/route"
                    android:textAppearance="@style/TextAppearance.Loft.IprowK"
                    android:textColor="@color/mute" />

                <TextView
                    android:id="@+id/row_route"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Loft.IprowV"
                    android:textColor="@color/snow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
