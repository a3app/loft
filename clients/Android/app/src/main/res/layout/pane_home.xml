<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/lamp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_lamp_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="-0.04"
            android:text="@string/app_name"
            android:textColor="@color/snow"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/ink2"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="@string/pill_off"
            android:textColor="@color/stone" />

        <Button
            android:id="@+id/go"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/lamp"
            android:text="@string/connect"
            android:textColor="@color/ink" />

        <LinearLayout
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_proto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/snow"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/card_front"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/snow"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/card_opt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/snow"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/speeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/lamp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row_ext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/stone"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/row_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/stone"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/row_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/stone"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/row_net"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/stone"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
