<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/btn_back"
        style="@style/Widget.Loft.IconBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="4dp"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />

    <!-- fillViewport + wrap_content: extra height goes to the spacers, so the lockup
         sits relative to the screen edges at any size. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/about_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1" />

            <ImageView
                android:id="@+id/mark"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_lamp_on" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Loft.Hero"
                android:textColor="@color/snow" />

            <TextView
                android:id="@+id/ver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Loft.IprowK"
                android:textColor="@color/mute" />

            <include layout="@layout/row_channel_about" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7" />

            <TextView
                android:id="@+id/kick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:includeFontPadding="false"
                android:text="@string/about_protos"
                android:textAppearance="@style/TextAppearance.Loft.Kick"
                android:textColor="@color/mute" />

            <LinearLayout
                android:id="@+id/protos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/proto_loft"
                    layout="@layout/row_proto" />

                <include
                    android:id="@+id/proto_sstp"
                    layout="@layout/row_proto" />

                <include
                    android:id="@+id/proto_trojan"
                    layout="@layout/row_proto" />

                <include
                    android:id="@+id/proto_vless"
                    layout="@layout/row_proto" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.75" />

            <TextView
                android:id="@+id/blurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/about_blurb"
                android:textAppearance="@style/TextAppearance.Loft.Blurb"
                android:textColor="@color/stone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.15" />

            <LinearLayout
                android:id="@+id/made"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/made_pre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/about_made_pre"
                    android:textAppearance="@style/TextAppearance.Loft.Made"
                    android:textColor="@color/mute" />

                <app.loft.android.HeartView
                    android:id="@+id/heart"
                    android:layout_width="14dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/made_post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/about_made_post"
                    android:textAppearance="@style/TextAppearance.Loft.Made"
                    android:textColor="@color/mute" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
