<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadeScrollbars="false"
    android:paddingEnd="16dp"
    android:scrollbarSize="4dp"
    android:scrollbarStyle="insideInset"
    android:scrollbarThumbVertical="@drawable/tv_scroll_thumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/snow"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/general"
            android:textColor="@color/lamp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/language"
            android:textColor="@color/snow"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/lang_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/lang_en"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_focus"
                android:backgroundTint="@null"
                android:minHeight="48dp"
                android:text="@string/lang_en"
                android:textAllCaps="false"
                android:textColor="@color/snow"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/lang_ru"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_focus"
                android:backgroundTint="@null"
                android:minHeight="48dp"
                android:text="@string/lang_ru"
                android:textAllCaps="false"
                android:textColor="@color/snow"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/lang_zh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_focus"
                android:backgroundTint="@null"
                android:minHeight="48dp"
                android:text="@string/lang_zh"
                android:textAllCaps="false"
                android:textColor="@color/snow"
                app:backgroundTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="16dp"
                android:text="@string/extended_log"
                android:textColor="@color/snow"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/route_group"
            android:textColor="@color/lamp"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="16dp"
                android:text="@string/default_route"
                android:textColor="@color/snow"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="16dp"
                android:text="@string/lan_bypass"
                android:textColor="@color/snow"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_lan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false" />
        </LinearLayout>

        <Button
            android:id="@+id/open_vpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_focus"
            android:minHeight="48dp"
            android:text="@string/open_sys"
            android:textAllCaps="false"
            android:textColor="@color/snow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/conn_group"
            android:textColor="@color/lamp"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="16dp"
                android:text="@string/auto"
                android:textColor="@color/snow"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="16dp"
                android:text="@string/reconnect"
                android:textColor="@color/snow"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_re"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false" />
        </LinearLayout>

        <include layout="@layout/row_channel" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/go_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_focus"
                android:minHeight="48dp"
                android:text="@string/log"
                android:textAllCaps="false"
                android:textColor="@color/snow" />

            <Button
                android:id="@+id/go_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/tv_focus"
                android:minHeight="48dp"
                android:text="@string/about"
                android:textAllCaps="false"
                android:textColor="@color/snow" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
