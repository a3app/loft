<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/snow"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/general"
            android:textColor="@color/lamp"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/extended_log"
            android:textColor="@color/snow"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/route_group"
            android:textColor="@color/lamp"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/default_route"
            android:textColor="@color/snow"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/sw_lan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/lan_bypass"
            android:textColor="@color/snow"
            android:textSize="20sp" />

        <Button
            android:id="@+id/open_vpn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_focus"
            android:minHeight="48dp"
            android:text="@string/open_sys"
            android:textAllCaps="false"
            android:textColor="@color/snow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/conn_group"
            android:textColor="@color/lamp"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/sw_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/auto"
            android:textColor="@color/snow"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/sw_re"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reconnect"
            android:textColor="@color/snow"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/go_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_focus"
                android:minHeight="48dp"
                android:text="@string/log"
                android:textAllCaps="false"
                android:textColor="@color/snow" />

            <Button
                android:id="@+id/go_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/tv_focus"
                android:minHeight="48dp"
                android:text="@string/about"
                android:textAllCaps="false"
                android:textColor="@color/snow" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
